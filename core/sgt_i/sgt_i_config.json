{
  "assertions": {
    "note": "Blueprint 14.4 step 6: trigger words for the assertion checker (core/sgt_i/assertions.py). One mechanism covers the past-tense rule, the future-stepper rule and the ack gate on every portal - a new portal's wording is a change here, never a code change. 'self' triggers assert their class wherever they appear; 'pre' triggers are generic negators whose scope runs forward from themselves to the next terminator (or the end of the text) - a 'happened' trigger falling inside that scope is negated, not happened (NegEx's own idea, ported from clinical text). Patterns are matched case-insensitively against the lower-cased text.",
    "terminators": ["\\bbut\\b", "\\bhowever\\b", "\\balthough\\b", "\\bexcept\\b", ";", ","],
    "negated": {
      "self": [
        "\\bfailed\\b",
        "\\brejected\\b",
        "\\bdeclined\\b",
        "\\bexpired\\b",
        "\\bunsuccessful\\b",
        "\\binvalid\\b",
        "not\\s+yet\\s+\\w+",
        "not\\s+found",
        "not\\s+available",
        "e-?verification\\s+failed"
      ],
      "pre": [
        "has\\s+not\\s+been",
        "have\\s+not\\s+been",
        "is\\s+not",
        "was\\s+not",
        "cannot\\s+be",
        "could\\s+not\\s+be",
        "\\bnot\\b"
      ],
      "post": []
    },
    "reference_to_past": {
      "self": [
        "of\\s+original\\s+return",
        "original\\s+return",
        "acknowledgement\\s+number\\s+of\\s+original",
        "previous\\s+(?:year|return|filing)",
        "as\\s+per\\s+(?:the\\s+)?(?:last|previous)\\s+filed"
      ]
    },
    "future_conditional": {
      "self": [
        "you\\s+will\\s+receive",
        "\\bwill\\s+\\w+",
        "once\\s+you",
        "after\\s+you\\s+submit",
        "\\bpending\\b",
        "still\\s+need\\s+to",
        "need\\s+to\\s+e-?verify",
        "within\\s+\\d+\\s+days",
        "under\\s+processing"
      ]
    },
    "happened": {
      "self": [
        "successfully",
        "e-?verified",
        "\\bverified\\b",
        "\\bfiled\\b",
        "\\bsubmitted\\b",
        "\\bprocessed\\b",
        "\\bcompleted\\b",
        "\\bgenerated\\b",
        "filing\\s+successful"
      ]
    }
  },
  "page_kinds": {
    "note": "Blueprint 14.4 step 6, second half: generic vocabulary for core/sgt_i/page_kinds.py. These are login/payment/profile/error words shared by many portals ('log in', 'otp', 'pay now', ...), never one portal's own field names - a new portal's wording is a change here, never a code change. Matched case-insensitively as whole words/phrases against heading, dialog and label text.",
    "login": ["log\\s*in", "sign\\s*in", "\\busername\\b", "\\bpassword\\b", "\\botp\\b", "\\bcaptcha\\b", "\\bpin\\b"],
    "payment": ["\\bpayment\\b", "\\bpay\\s*now\\b", "amount\\s+due", "amount\\s+payable", "\\bchallan\\b", "net\\s*banking", "\\bupi\\b", "\\bcheckout\\b"],
    "profile": ["\\bprofile\\b", "my\\s+account", "personal\\s+details", "\\bmy\\s+profile\\b", "update\\s+profile", "account\\s+details"],
    "error": ["\\berror\\b", "something\\s+went\\s+wrong", "\\btry\\s+again\\b", "\\bunable\\s+to\\b", "page\\s+not\\s+found", "\\bunavailable\\b"]
  },
  "ledger": {
    "note": "Blueprint 14.4 step 7: weights and dataset constraints for the evidence ledger (core/sgt_i/ledger.py). Weights are hand-set; they are to be tuned by counting on the corpus, never learned by a model. A sighting's weight is source x page kind x assertion x the Core's own confidence; a belief's score combines its sightings as 1 - product(1 - w). Constraints only ever produce a second opinion on the row - the Core's value stands (14.2). A new form, portal or period wording is a change here, never a code change.",
    "source": {"uia": 1.0, "pdf": 0.9, "ocr": 0.75, "_none": 0.7},
    "page_kind": {"confirmation": 1.0, "list": 0.9, "profile": 0.9, "dashboard": 0.8, "payment": 0.6, "wizard_step": 0.5, "login": 0.4, "error": 0.3, "_none": 0.7},
    "assertion": {"happened": 1.0, "_none": 0.8, "future_conditional": 0.5, "reference_to_past": 0.3, "negated": 0.2},
    "assertion_window": {"before": 3, "after": 2},
    "max_lines_for_page_kind": 400,
    "client_fields": ["pan", "gstin", "tan"],
    "identifier_fields": ["arn"],
    "show_tail": {"arn": 6},
    "pan_letter_names": {"P": "an individual's", "C": "a company's", "H": "a HUF's", "F": "a firm's", "A": "an AOP's", "B": "a BOI's", "T": "a trust's", "L": "a local authority's", "J": "an artificial juridical person's", "G": "a government's"},
    "form_pan_letters": {
      "^ITR-1$": "P",
      "^ITR-2$": "PH",
      "^ITR-3$": "PH",
      "^ITR-4$": "PHF",
      "^ITR-5$": "FABLJT",
      "^ITR-6$": "C"
    },
    "period_kinds": {
      "quarterly": ["\\bq[1-4]\\b", "\\bquarter\\b"],
      "monthly": ["\\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\\b"],
      "annual": ["^\\s*a\\.?y\\.?\\s*20\\d{2}", "^\\s*f\\.?y\\.?\\s*20\\d{2}"]
    },
    "form_periods": {
      "^(?:24|26|27)Q$|^27EQ$|^CMP-?08$": "quarterly",
      "^ITR-?(?:[1-7]|U)$": "annual",
      "^GSTR-9C?$": "annual"
    },
    "identifier_dates": [
      {"field": "arn", "forms": "^ITR", "pattern": "^\\d{9}(\\d{2})(\\d{2})(\\d{2})$", "order": "DMY"}
    ],
    "period_grace_days": {"ay": 0, "fy": 1000, "month": 400, "quarter": 400},
    "exempt_filing_types": ["Updated"],
    "portal_forms": {
      "income tax": ["^ITR-?(?:[1-7]|U)$"],
      "gst": ["^GSTR-", "^CMP-?08$", "^ITC-"]
    }
  }
}
