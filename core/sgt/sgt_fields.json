{
  "version": 1,
  "about": "Sera Global Tracker field specs. Edit to add or remove datapoints - no code change. Every spec must carry examples; a spec that fails its own examples is refused at load and the previous version keeps running. Put local overrides in an sgt_fields.json next to the app: a spec with the same name replaces this one, \"disabled\": true removes it. See docs/sgt-blueprint.md.",

  "profile_rules": {
    "note": "Profile datapoints built from parts. {x?} may be missing. A composed value is offered like a read one, so the name still only ever grows (promote_longer).",
    "compose": {"name": "{first_name} {middle_name?} {last_name}"}
  },

  "profile": [
    {
      "name": "itr_header_name",
      "field": "name",
      "merge": "promote_longer",
      "portals": ["Income Tax"],
      "take": "anywhere",
      "pattern": "^([A-Z][A-Z .'&]*[A-Z.]) (?:Individual|HUF|Company|Firm|AOP|BOI|Trust|Local Authority|Artificial Juridical Person)$",
      "transforms": ["collapse_spaces"],
      "checks": ["looks_like_name", "not_ui_chrome"],
      "confidence": 85,
      "note": "The profile menu button in the portal header, on every page: '<NAME> Individual'. The CA's own login shows a CA/ERI role, which this does not accept.",
      "examples": ["ASHOK KUMAR SEN Individual", "SEN TRADING CO Firm"],
      "counter_examples": ["ASHOK KUMAR SEN Chartered Accountant", "Dashboard Individual", "Individual"]
    },
    {
      "name": "itr_profile_name",
      "field": "name",
      "merge": "promote_longer",
      "portals": ["Income Tax"],
      "urls": ["myProfile"],
      "labels": ["Name"],
      "label_rest": "separated",
      "within": 1,
      "pattern": "^([A-Za-z][A-Za-z .'&]*[A-Za-z.])$",
      "transforms": ["collapse_spaces"],
      "checks": ["looks_like_name", "not_ui_chrome"],
      "confidence": 90,
      "examples": [
        "ASHOK KUMAR SEN",
        {"lines": ["Profile", "Name", "ASHOK KUMAR SEN", "Date of Birth", "12-Mar-1980"], "expect": "ASHOK KUMAR SEN"}
      ],
      "counter_examples": [
        "Search Box Input Field",
        "ABCPD1234E",
        {"lines": ["Name of the Bank", "STATE BANK OF INDIA"]}
      ]
    },
    {
      "name": "itr_first_name",
      "field": "first_name",
      "portals": ["Income Tax"],
      "labels": ["First Name"],
      "within": 2,
      "pattern": "^(?!.*\\bName\\b)([A-Za-z][A-Za-z .'-]*[A-Za-z.]|[A-Za-z])$",
      "transforms": ["collapse_spaces"],
      "checks": ["not_ui_chrome"],
      "confidence": 90,
      "note": "Name parts, joined by profile_rules.compose. A value may never contain the word 'Name': an empty field would otherwise swallow the next label.",
      "examples": ["WASIL", {"lines": ["First Name", "First Name", "ASHOK"], "expect": "ASHOK"}],
      "counter_examples": ["Last Name", "12345", {"lines": ["First Name", "First Name", "Middle Name"]}]
    },
    {
      "name": "itr_middle_name",
      "field": "middle_name",
      "portals": ["Income Tax"],
      "labels": ["Middle Name"],
      "within": 2,
      "pattern": "^(?!.*\\bName\\b)([A-Za-z][A-Za-z .'-]*[A-Za-z.]|[A-Za-z])$",
      "transforms": ["collapse_spaces"],
      "checks": ["not_ui_chrome"],
      "confidence": 90,
      "examples": ["KUMAR", "K", {"lines": ["Middle Name", "Middle Name", "KUMAR"], "expect": "KUMAR"}],
      "counter_examples": [{"lines": ["Middle Name", "Middle Name", "Last Name", "Last Name", "SEN"]}]
    },
    {
      "name": "itr_last_name",
      "field": "last_name",
      "portals": ["Income Tax"],
      "labels": ["Last Name", "Surname"],
      "within": 2,
      "pattern": "^(?!.*\\bName\\b)([A-Za-z][A-Za-z .'-]*[A-Za-z.]|[A-Za-z])$",
      "transforms": ["collapse_spaces"],
      "checks": ["not_ui_chrome"],
      "confidence": 90,
      "examples": ["SEN", {"lines": ["Last Name", "Last Name", "SEN", "PAN"], "expect": "SEN"}],
      "counter_examples": [{"lines": ["Last Name", "Last Name", "PAN", "ABCPD1234E"]}]
    },
    {
      "name": "itr_pan",
      "field": "pan",
      "portals": ["Income Tax"],
      "urls": ["myProfile", "foreturns", "fo-itr", "#/login/password"],
      "note": "The password page shows 'PAN' and the PAN being logged into, before the dashboard.",
      "labels": ["PAN"],
      "within": 2,
      "pattern": "(?<![A-Z0-9])([A-Z]{5}[0-9]{4}[A-Z])(?![A-Z0-9])",
      "confidence": 95,
      "examples": [
        "ABCPD1234E",
        {"lines": ["PAN", "PAN", "ABCPD1234E", "Gender"], "expect": "ABCPD1234E"},
        {"lines": ["PAN : ABCPD1234E"], "expect": "ABCPD1234E"}
      ],
      "counter_examples": [
        "ABCPD1234",
        {"lines": ["PAN of the Employer", "XYZAB9876C"]},
        {"lines": ["PAN", "ABCPD1234E", "PAN", "XYZAB9876C"]}
      ]
    },
    {
      "name": "itr_dashboard_pan",
      "field": "pan",
      "portals": ["Income Tax"],
      "urls": ["#/dashboard/?$"],
      "labels": ["Welcome Back"],
      "label_rest": "ignore",
      "within": 2,
      "pattern": "^([A-Z]{5}[0-9]{4}[A-Z])$",
      "confidence": 90,
      "note": "The dashboard greets the taxpayer by first name and prints the PAN on the next line, unlabelled.",
      "examples": [
        {"lines": ["Welcome Back, ASHOK", "ABCPD1234E", "XXXXXXXX1234"], "expect": "ABCPD1234E"}
      ],
      "counter_examples": [
        {"lines": ["Welcome Back, ASHOK", "Update Contact Details", "Pending Actions", "ABCPD1234E"]}
      ]
    },
    {
      "name": "itr_dob",
      "field": "dob",
      "portals": ["Income Tax"],
      "urls": ["myProfile", "foreturns", "fo-itr"],
      "labels": ["Date of Birth", "Date of Birth / Formation", "Date of Birth/Formation", "Date of Birth / Incorporation"],
      "within": 2,
      "pattern": "(\\d{1,2}-[A-Za-z]{3}-\\d{4}|\\d{2}/\\d{2}/\\d{4})",
      "transforms": ["parse_date"],
      "checks": ["not_future"],
      "confidence": 90,
      "examples": [
        "12-Mar-1980",
        {"lines": ["Date of Birth / Formation", "Date of Birth / Formation", "12-Mar-1980"], "expect": "1980-03-12"}
      ],
      "counter_examples": ["31-Feb-1980", "12-Mar-2099"]
    },
    {
      "name": "itr_email",
      "field": "email",
      "portals": ["Income Tax"],
      "urls": ["myProfile", "foreturns", "fo-itr"],
      "labels": ["Email", "Primary Email ID of the taxpayer", "Primary Email ID"],
      "within": 3,
      "pattern": "(?<![A-Za-z0-9._%+-])([A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})",
      "transforms": ["lower"],
      "confidence": 90,
      "examples": [
        "ashok.sen@example.com",
        {"lines": ["Email", "Primary (Self)", "ashok.sen@example.com", "Secondary (--)"], "expect": "ashok.sen@example.com"}
      ],
      "counter_examples": ["ashok.sen@", "Email"]
    },
    {
      "name": "itr_phone",
      "field": "phone",
      "portals": ["Income Tax"],
      "urls": ["myProfile", "foreturns", "fo-itr"],
      "labels": ["Mobile", "Primary Mobile No.", "Primary Mobile No"],
      "within": 4,
      "pattern": "(?<![0-9])([6-9][0-9]{9})(?![0-9])",
      "confidence": 85,
      "examples": [
        "9876543210",
        {"lines": ["Mobile", "Primary (Self)", "+91", "9876543210", "Secondary (--)"], "expect": "9876543210"}
      ],
      "counter_examples": ["12345", "1234567890", "98765432101"]
    },
    {
      "name": "itr_tan",
      "field": "tan",
      "portals": ["Income Tax"],
      "labels": ["TAN", "Tax Deduction Account Number", "TAN of the Deductor", "TAN of Deductor"],
      "within": 3,
      "pattern": "(?<![A-Z0-9])([A-Z]{4}[0-9]{5}[A-Z])(?![A-Z0-9])",
      "confidence": 95,
      "examples": [
        "MUMA12345B",
        {"lines": ["TAN of the Deductor", "MUMA12345B", "Name"], "expect": "MUMA12345B"}
      ],
      "counter_examples": [
        "ABCPD1234E",
        "Search Box Input Field",
        {"lines": ["TAN of the Deductor", "MUMA12345"]}
      ]
    },
    {
      "name": "gst_welcome_name",
      "field": "name",
      "merge": "promote_longer",
      "portals": ["GST Portal"],
      "labels": ["Welcome"],
      "pattern": "^(.+?) to GST Common Portal$",
      "transforms": ["collapse_spaces"],
      "checks": ["looks_like_name", "not_ui_chrome"],
      "confidence": 90,
      "examples": [
        "ASHOK KUMAR SEN to GST Common Portal",
        {"lines": ["Welcome ASHOK KUMAR SEN to GST Common Portal"], "expect": "ASHOK KUMAR SEN"}
      ],
      "counter_examples": [{"lines": ["Welcome to GST Common Portal"]}, "Dashboard to GST Common Portal"]
    },
    {
      "name": "gst_gstin",
      "field": "gstin",
      "portals": ["GST Portal"],
      "urls": ["fowelcome", "/auth/dashboard"],
      "take": "anywhere",
      "pattern": "(?<![A-Z0-9])([0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z])(?![A-Z0-9])",
      "checks": ["gstin_checksum"],
      "confidence": 90,
      "note": "The welcome page prints the logged-in GSTIN under the name. Two different GSTINs on one page are a conflict and neither is taken.",
      "examples": [
        "19ABCPD1234E1ZB",
        {"lines": ["ASHOK KUMAR SEN", "19ABCPD1234E1ZB", "View Profile"], "expect": "19ABCPD1234E1ZB"}
      ],
      "counter_examples": [
        "19ABCPD1234E1ZC",
        {"lines": ["19ABCPD1234E1ZB", "27AAACZ9876K1ZE"]}
      ]
    }
  ],

  "submit_rules": {
    "note": "Every dataset's status is one level of the same ladder on every portal: Not Submitted (default) -> Draft -> Submitted (Not Verified) -> Submitted & Verified, and it only ever moves up. It climbs with what has been captured: form + period of the dataset being worked on -> Draft; + an ARN/ack -> Submitted (Not Verified); + a submit message -> whatever the message says (its wording decides: 'pending e-verification' stays Not Verified, 'e-verified' is Verified). A status field's map turns the portal's wording into a level (the loader refuses any other output) and the wording is kept as evidence. identifier_proves is the exception list: a portal whose ARN proves MORE on its own. GST issues the ARN only once the return is filed with DSC/EVC.",
    "identifier_proves": {
      "GST Portal": "Submitted & Verified"
    }
  },

  "dataset_rules": {
    "note": "Checks on a WHOLE dataset before it is written to the tracker. Every field can look right on its own and still not fit together; a dataset that breaks a rule is HELD with the reason (in the SGT log) and written once later pages fix it. Rules only check values that are present - a missing field is the completeness rule's job. Every rule carries examples it passes and holds; the loader refuses a rule whose examples fail.",
    "rules": [
      {
        "name": "itr_period_is_an_assessment_year",
        "portals": ["Income Tax"],
        "when": {"form": "^ITR"},
        "require": {"period": "^AY 20\\d{2}-\\d{2}$"},
        "checks": {"period": ["years_consecutive"]},
        "message": "an ITR's period must be an assessment year such as AY 2026-27",
        "examples": [
          {"dataset": {"form": "ITR-4", "period": "AY 2026-27"}, "ok": true},
          {"dataset": {"form": "ITR-4", "period": "June (FY 2026-27)"}, "ok": false},
          {"dataset": {"form": "ITR-4", "period": "AY 2026-28"}, "ok": false}
        ]
      },
      {
        "name": "itr_ack_date_fits_its_year",
        "portals": ["Income Tax"],
        "date_tail": {"field": "arn", "not_future": true, "not_before_period_start": true},
        "message": "the acknowledgement's own date (its last six digits, DDMMYY) is not a real date between the assessment year's start and today - probably a misread number",
        "examples": [
          {"dataset": {"form": "ITR-4", "period": "AY 2026-27", "arn": "123456789150726"}, "today": "2026-09-22", "ok": true},
          {"dataset": {"form": "ITR-4", "period": "AY 2026-27", "arn": "123456789150725"}, "today": "2026-09-22", "ok": false},
          {"dataset": {"form": "ITR-4", "period": "AY 2026-27", "arn": "123456789151226"}, "today": "2026-09-22", "ok": false},
          {"dataset": {"form": "ITR-4", "period": "AY 2026-27", "arn": "123456789993026"}, "today": "2026-09-22", "ok": false}
        ]
      },
      {
        "name": "gst_period_is_a_tax_period",
        "portals": ["GST Portal"],
        "when": {"form": "^(GSTR|CMP|IFF)"},
        "require": {"period": "\\(FY 20\\d{2}-\\d{2}\\)$|^FY 20\\d{2}-\\d{2}$"},
        "message": "a GST return's period must be a tax period of a financial year, such as August (FY 2026-27)",
        "examples": [
          {"dataset": {"form": "GSTR-3B", "period": "August (FY 2026-27)"}, "ok": true},
          {"dataset": {"form": "GSTR-9", "period": "FY 2025-26"}, "ok": true},
          {"dataset": {"form": "GSTR-3B", "period": "AY 2026-27"}, "ok": false}
        ]
      },
      {
        "name": "form_belongs_to_the_portal",
        "portals": ["Income Tax"],
        "require": {"form": "^(?!GSTR|CMP|IFF)"},
        "message": "a GST form was read on the Income Tax portal - probably text from another tab or a help panel",
        "examples": [
          {"dataset": {"form": "ITR-4", "period": "AY 2026-27"}, "ok": true},
          {"dataset": {"form": "GSTR-3B", "period": "AY 2026-27"}, "ok": false}
        ]
      },
      {
        "name": "gst_form_belongs_to_the_portal",
        "portals": ["GST Portal"],
        "require": {"form": "^(?!ITR)"},
        "message": "an ITR form was read on the GST portal - probably text from another tab or a help panel",
        "examples": [
          {"dataset": {"form": "GSTR-1", "period": "August (FY 2026-27)"}, "ok": true},
          {"dataset": {"form": "ITR-4", "period": "August (FY 2026-27)"}, "ok": false}
        ]
      }
    ]
  },

  "records": [
    {
      "name": "itr_dataset_cards",
      "portals": ["Income Tax"],
      "note": "One card per filed dataset, wherever the portal lists them: View Filed Returns heads each card 'A.Y. 2025-26'; the e-Verify picker heads it 'Assessment Year' then '2025-26'. The card's own history decides the status when it has one; otherwise what the page says about all its cards does; otherwise the ack alone (submit_rules).",
      "start": "^(?:A\\.Y\\.\\s*20\\d{2}-\\d{2}|Assessment Year)$",
      "max_lines": 45,
      "require": ["period", "arn"],
      "fields": [
        {
          "field": "period",
          "take": "anywhere",
          "pattern": "A\\.Y\\.\\s*(20\\d{2}-\\d{2})",
          "transforms": ["ay_label"],
          "checks": ["years_consecutive"],
          "confidence": 95,
          "examples": ["A.Y. 2025-26"],
          "counter_examples": ["A.Y. 2025-27"]
        },
        {
          "field": "period",
          "labels": ["Assessment Year"],
          "within": 1,
          "pattern": "^(20\\d{2}-\\d{2})$",
          "transforms": ["ay_label"],
          "checks": ["years_consecutive"],
          "confidence": 95,
          "examples": ["2025-26"],
          "counter_examples": ["2025-27"]
        },
        {
          "field": "form",
          "labels": ["ITR"],
          "within": 2,
          "pattern": "^(ITR ?-? ?[1-7])$",
          "transforms": ["dash_form"],
          "confidence": 95,
          "examples": ["ITR-4", "ITR 1"],
          "counter_examples": ["ITR-9", "ITR Filed"]
        },
        {
          "field": "arn",
          "labels": ["Acknowledgement No", "Acknowledgement Number"],
          "within": 2,
          "pattern": "(?<![0-9A-Za-z])([0-9OoIlSB]{15})(?![0-9A-Za-z])",
          "transforms": ["ocr_digits"],
          "checks": ["all_digits", "ddmmyy_tail_real"],
          "confidence": 95,
          "examples": ["123456789150925", "12345678915O925"],
          "counter_examples": ["123456789320925", "12345678915092"]
        },
        {
          "field": "pan",
          "labels": ["PAN"],
          "within": 2,
          "pattern": "(?<![A-Z0-9])([A-Z]{5}[0-9]{4}[A-Z])(?![A-Z0-9])",
          "confidence": 95,
          "note": "The client the card belongs to. A card naming another PAN than the session's client is never attributed to them.",
          "examples": ["ABCPD1234E"],
          "counter_examples": ["ABCPD1234"]
        },
        {
          "field": "filing_type",
          "labels": ["Filing Type"],
          "within": 2,
          "pattern": "^(Original|Revised|Belated|Updated)$",
          "confidence": 90,
          "examples": ["Original"],
          "counter_examples": ["done"]
        },
        {
          "field": "filing_date",
          "labels": ["Filing Date", "Filed On"],
          "within": 2,
          "pattern": "([A-Z][a-z]{2} \\d{1,2}, 20\\d{2})",
          "transforms": ["parse_date"],
          "checks": ["not_future"],
          "confidence": 90,
          "examples": ["Sep 15, 2025"],
          "counter_examples": ["Sep 31, 2025"]
        },
        {
          "field": "status",
          "take": "anywhere",
          "case": "insensitive",
          "pattern": "^(pending for e-?verification|itr filed|e-?verified|successfully e-?verified|return verified|under processing|processed.*)$",
          "pick": "map_order",
          "map": [
            ["processed|under processing|verified", "Submitted & Verified"],
            ["pending for e-?verification|itr filed", "Submitted (Not Verified)"]
          ],
          "confidence": 90,
          "note": "A card lists its status history newest first; the map order is the ladder, so the furthest-along level on the card wins. 'Processed ...' / 'Under Processing' come after verification, so they prove it.",
          "examples": ["Pending for e-verification", "ITR Filed", "Processed with no demand/refund", "Successfully e-Verified"],
          "counter_examples": ["done", "Filing Type"]
        },
        {
          "field": "status",
          "scope": "page",
          "take": "anywhere",
          "case": "insensitive",
          "pattern": "(select the return you would like to (?:e-?)?verify|e-?verify\\s*/\\s*discard return)",
          "map": [
            [".", "Submitted (Not Verified)"]
          ],
          "confidence": 90,
          "note": "A page that asks which return to verify lists only returns awaiting verification - a fact about every card on it.",
          "examples": ["Please select the return you would like to verify/discard", "e-Verify / Discard Return"],
          "counter_examples": ["Return Successfully Verified", "e-Verify Return"]
        }
      ],
      "examples": [
        {
          "lines": [
            "View Filed Returns",
            "The e-Filed Returns are available for download /view starting Assessment Year 2013-14.",
            "2 Filings till date",
            "A.Y. 2025-26", "Filing Type", "Original", "done", "Pending for e-verification", "Sep 15, 2025",
            "done", "ITR Filed", "Sep 15, 2025", "ITR :", "ITR-4", "Acknowledgement No :", "123456789150925",
            "Filed By :", "self", "Filing Date :", "Sep 15, 2025", "Filing Section :", "139(1)", "View Details",
            "A.Y. 2024-25", "Filing Type", "Original", "done", "Processed with no demand/refund", "Sep 3, 2024",
            "done", "Under Processing", "Sep 3, 2024", "done", "ITR Filed", "Jul 31, 2024", "ITR :", "ITR-1",
            "Acknowledgement No :", "987654321310724", "Filing Date :", "Jul 31, 2024", "View Details"
          ],
          "expect": [
            {"period": "AY 2025-26", "form": "ITR-4", "arn": "123456789150925", "filing_type": "Original",
             "filing_date": "2025-09-15", "status": "Submitted (Not Verified)"},
            {"period": "AY 2024-25", "form": "ITR-1", "arn": "987654321310724", "filing_type": "Original",
             "filing_date": "2024-07-31", "status": "Submitted & Verified"}
          ]
        },
        {
          "lines": [
            "Current Step 1 of 3 in stepper", "Select The Return To Be Verified", "1",
            "Unvisited Step 2 of 3 in stepper", "Select Method For Return Verification", "2",
            "Unvisited Step 3 of 3 in stepper", "Return Successfully Verified", "3",
            "e-Verify / Discard Return", "Please select the return you would like to verify/discard",
            "Showing (1) returns", "Search Box Input Field",
            "Assessment Year", "2025-26", "ITR", "ITR 4", "Filing Type", "Original",
            "PAN :", "ABCPD1234E", "Acknowledgement Number :", "123456789180925",
            "Filed On :", "Sep 18, 2025", "Applicable Act :", "Income Tax Act 1961", "e verify", "Discard"
          ],
          "expect": [
            {"period": "AY 2025-26", "form": "ITR-4", "arn": "123456789180925", "pan": "ABCPD1234E",
             "filing_type": "Original", "filing_date": "2025-09-18", "status": "Submitted (Not Verified)"}
          ]
        },
        {
          "lines": ["Select Assessment Year", "Assessment Year", "2026-27", "Filing Type", "Original", "Continue"],
          "expect": []
        }
      ]
    },
    {
      "name": "itr_submit_success",
      "portals": ["Income Tax"],
      "note": "The confirmation shown right after submitting. The ack must carry today's date (its last six digits are DDMMYY), so an old ack on a revised-return page never counts as a new filing. The ack alone is a submission (Submitted, Not Verified); the message, when read, decides the rest.",
      "require": ["arn"],
      "fields": [
        {
          "field": "arn",
          "labels": ["Acknowledgement Number", "Acknowledgement No"],
          "within": 2,
          "pattern": "(?<![0-9A-Za-z])([0-9OoIlSB]{15})(?![0-9A-Za-z])",
          "transforms": ["ocr_digits"],
          "checks": ["all_digits", "ddmmyy_tail_today"],
          "confidence": 90,
          "examples": ["123456789150726"],
          "counter_examples": ["123456789150925"]
        },
        {
          "field": "status",
          "take": "anywhere",
          "case": "insensitive",
          "pattern": "(successfully (?:submitted|filed|e-?verified)|(?:submitted|filed|e-?verified) successfully|still need to e-?verify|e-?verify within \\d+ days)",
          "pick": "map_order",
          "map": [
            ["e-?verified", "Submitted & Verified"],
            ["still need|within", "Submitted (Not Verified)"],
            ["submitted|filed", "Submitted (Not Verified)"]
          ],
          "confidence": 90,
          "examples": ["You have successfully submitted your return!", "Return filed successfully"],
          "counter_examples": ["Once you submit, you will receive an acknowledgement"]
        },
        {
          "field": "form",
          "take": "anywhere",
          "pattern": "(?<![A-Za-z0-9])(ITR ?-? ?[1-7])(?![0-9])",
          "transforms": ["dash_form"],
          "confidence": 80,
          "examples": ["ITR-4 for A.Y. 2026-27"]
        },
        {
          "field": "period",
          "take": "anywhere",
          "pattern": "A\\.?Y\\.? ?(20\\d{2} ?- ?\\d{2,4})",
          "transforms": ["ay_label"],
          "checks": ["years_consecutive"],
          "confidence": 80,
          "examples": ["A.Y. 2026-27"]
        }
      ],
      "examples": [
        {
          "lines": ["You have successfully submitted your return!", "Acknowledgement Number :", "123456789150726",
                    "You still need to e-Verify within 30 days to complete the process of return filing."],
          "expect": [{"arn": "123456789150726", "status": "Submitted (Not Verified)"}]
        },
        {
          "lines": ["Original return details", "Acknowledgement Number :", "123456789150925", "Filed successfully"],
