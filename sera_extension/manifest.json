{
  "manifest_version": 3,
  "name": "Project Sera Companion",
  "version": "1.0",
  "description": "Autofill and filing confirmation tracking for Aman Associates.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Show Sera Manual Assist"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tracker.js", "content_scripts/login.js", "content_scripts/filing_detector.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["config.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
