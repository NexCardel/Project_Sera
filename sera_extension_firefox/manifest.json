{
  "manifest_version": 3,
  "name": "Project Sera Companion",
  "version": "2.9.6",
  "description": "Autofill and filing confirmation tracking for Aman Associates.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sera-companion@amanassociates.com",
      "strict_min_version": "109.0"
    }
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "browsingData",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Project Sera Companion",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file://*/*"
      ],
      "js": [
        "content_scripts/sca_adapters.js",
        "content_scripts/login.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.json",
        "event_types.json",
        "content_scripts/net_interceptor.js",
        "content_scripts/filing_detector.js",
        "tracker.js",
        "sdc/sdc_toast.js",
        "sdc/sdc_core.js",
        "sdc/protocols/itr_protocol.js",
        "sdc/protocols/gst_protocol.js",
        "sdc/protocols/traces_protocol.js",
        "sdc/protocols/mca_protocol.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}